---
import Base from '../layouts/Base.astro';

// Baked in at build time; a script in the footer refreshes it at runtime so
// the year is still right if the site goes a long stretch without a deploy.
const copyright = `© ${new Date().getFullYear()} Pierce Liefeld`;

const photos = [
  { src: '/photos/Glimpse.jpg', alt: 'Glimpse' },
  { src: '/photos/Isolated.jpg', alt: 'Isolated' },
  { src: '/photos/Kill-With-A-Smile.jpg', alt: 'Kill With A Smile' },
  { src: '/photos/A-Story-My-Father-Told-Me.jpg', alt: 'A Story My Father Told Me' },
  { src: '/photos/Scale.jpg', alt: 'Scale' },
  { src: '/photos/Not-So-Blue.jpg', alt: 'Not So Blue' },
  { src: '/photos/Procession.jpg', alt: 'Procession' },
  { src: '/photos/Light-the-Way.jpg', alt: 'Light the Way' },
  { src: '/photos/Live-Die-Live-Again.jpg', alt: 'Live Die Live Again' },
  { src: '/photos/Tolt.jpg', alt: 'Tölt' },
  { src: '/photos/Pass-the-Salt.jpg', alt: 'Pass the Salt' },
  { src: '/photos/Happy-Neigh-Year.jpg', alt: 'Happy Neigh Year' },
  { src: '/photos/Two-Birds.jpg', alt: 'Two Birds' },
  { src: '/photos/My-Light.jpg', alt: 'My Light' },
  { src: '/photos/Steering-Contest.jpg', alt: 'Steering Contest' },
  { src: '/photos/No-Nagging.jpg', alt: 'No Nagging' },
  { src: '/photos/Swoop.jpg', alt: 'Swoop' },
  { src: '/photos/Twinning.jpg', alt: 'Twinning' },
];
---

<Base
  title="Pierce Liefeld — Photographer & Founder of COGNAK"
  description="Photography by Pierce Liefeld. Art director and founder of COGNAK."
>
  <!-- Person + Organization schema -->
  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://pierceliefeld.com/#pierce",
        "name": "Pierce Liefeld",
        "url": "https://pierceliefeld.com",
        "image": "https://pierceliefeld.com/photos/Glimpse.jpg",
        "jobTitle": "Art Director",
        "description": "Art director, photographer, and founder of COGNAK.",
        "sameAs": ["https://cognak.com"],
        "worksFor": {
          "@type": "Organization",
          "@id": "https://cognak.com/#organization"
        }
      },
      {
        "@type": "Organization",
        "@id": "https://cognak.com/#organization",
        "name": "COGNAK",
        "url": "https://cognak.com",
        "founder": { "@id": "https://pierceliefeld.com/#pierce" }
      }
    ]
  })}</script>

  <main>
    <header>
      <div class="bio reveal">
        <h1>Pierce Liefeld</h1>
        <p>
          Art director. Photographer. Founder of&nbsp;<span class="cognak-wrap">
            <a href="https://cognak.com" target="_blank" rel="noopener" id="cognak-link">COGNAK</a>
            <span class="cognak-preview" id="cognak-preview">
              <iframe src="https://cognak.com" scrolling="no" tabindex="-1" loading="lazy" title="COGNAK"></iframe>
            </span>
          </span>.
        </p>
      </div>
    </header>

    <section class="grid">
      {photos.map((photo, i) => (
        <div class="photo-item reveal" style={`transition-delay: ${Math.min(i * 40, 200)}ms`}>
          <img
            src={photo.src}
            alt={photo.alt}
            loading={i < 6 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))}
    </section>

    <footer>
      <span class="critter" aria-hidden="true"><span class="critter-glyph">🐃</span></span>
      <span class="decode" data-text={copyright}>{copyright}</span>
    </footer>
  </main>

  <!-- Randomize photo order on every page load -->
  <script is:inline>
    (function () {
      var grid = document.querySelector('.grid');
      if (!grid) return;
      var items = Array.prototype.slice.call(grid.children);
      for (var i = items.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = items[i]; items[i] = items[j]; items[j] = t;
      }
      items.forEach(function (el, idx) {
        el.style.transitionDelay = Math.min(idx * 40, 200) + 'ms';
        grid.appendChild(el);
      });
    })();
  </script>

  <!-- Roll the © year over at runtime. The page is statically built, so the
       year baked in at build time goes stale if the site isn't redeployed.
       Must stay above the decode script, which replaces .decode's contents
       with one span per character, and must not sit behind that script's
       reduced-motion early return. -->
  <script is:inline>
    (function () {
      var el = document.querySelector('footer .decode');
      if (!el) return;
      var text = (el.getAttribute('data-text') || el.textContent)
        .replace(/\b\d{4}\b/, new Date().getFullYear());
      el.setAttribute('data-text', text);
      el.textContent = text;
    })();
  </script>

  <!-- Footer text decode effect -->
  <script is:inline>
    (function () {
      var el = document.querySelector('footer .decode');
      if (!el) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var target = el.getAttribute('data-text') || el.textContent;
      var glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#%&*<>/';

      // Build a span per character
      el.textContent = '';
      var spans = [];
      for (var i = 0; i < target.length; i++) {
        var s = document.createElement('span');
        s.className = 'char';
        el.appendChild(s);
        spans.push(s);
      }

      function rand() { return glyphs[Math.floor(Math.random() * glyphs.length)]; }

      function run() {
        var settle = [];   // frame index at which each char locks in
        var total = 38;    // total frames
        for (var i = 0; i < target.length; i++) {
          settle[i] = Math.floor((i / target.length) * (total - 10)) + Math.floor(Math.random() * 8);
        }

        var frame = 0;
        function tick() {
          for (var i = 0; i < spans.length; i++) {
            var ch = target[i];
            if (ch === ' ') { spans[i].textContent = ' '; spans[i].className = 'char'; continue; }
            if (frame >= settle[i]) {
              spans[i].textContent = ch;
              spans[i].className = 'char';
            } else {
              spans[i].textContent = rand();
              spans[i].className = 'char scrambling';
            }
          }
          frame++;
          if (frame <= total) {
            requestAnimationFrame(tick);
          } else {
            for (var j = 0; j < spans.length; j++) {
              spans[j].textContent = target[j];
              spans[j].className = 'char';
            }
          }
        }
        tick();
      }

      // Kick off when the footer scrolls into view
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { run(); io.unobserve(entry.target); }
          });
        }, { threshold: 0.6 });
        io.observe(el);
      } else {
        run();
      }
    })();
  </script>

  <!-- Easter egg: hover the copyright and a water buffalo trots through the footer -->
  <script is:inline>
    (function () {
      var footer = document.querySelector('footer');
      if (!footer) return;
      var trigger = footer.querySelector('.decode');
      var critter = footer.querySelector('.critter');
      if (!trigger || !critter) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var running = false;

      function gallop() {
        if (running) return;
        running = true;
        footer.classList.add('trotting');
      }

      // Only the travel animation is finite, and it lives on .critter itself —
      // the bob loop is infinite and never fires animationend.
      critter.addEventListener('animationend', function (e) {
        if (e.target !== critter) return;
        footer.classList.remove('trotting');
        running = false;
      });

      trigger.addEventListener('mouseenter', gallop);
      trigger.addEventListener('click', gallop);
      trigger.addEventListener('touchstart', gallop, { passive: true });
    })();
  </script>
</Base>

<style>
  main {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  header {
    padding: 3rem 2rem 2rem;
    max-width: var(--max-w);
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  .bio h1 {
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--fg);
    margin-bottom: 0.35rem;
  }

  .bio p {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--fg-muted);
    line-height: 1.5;
  }

  /* COGNAK link + preview card */
  .cognak-wrap {
    position: relative;
    display: inline-block;
  }

  .bio a,
  .bio a:hover,
  .bio a:active,
  .bio a:focus {
    color: #9F50FF;
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .cognak-preview {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    width: 384px;
    height: 216px; /* 16:9 hero ratio */
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0,0,0,0.6), 0 0 0 1px rgba(159,80,255,0.25);
    opacity: 0;
    transform: translateY(-6px) scale(0.97);
    transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 100;
  }

  .cognak-wrap:hover .cognak-preview {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .cognak-preview iframe {
    width: 1536px;
    height: 864px; /* 16:9 of 1536 */
    transform: scale(0.25);
    transform-origin: top left;
    border: none;
    pointer-events: none;
  }

  /* Masonry */
  .grid {
    column-count: 3;
    column-gap: var(--gap);
    padding: 0 var(--gap) var(--gap);
    flex: 1;
  }

  .photo-item {
    break-inside: avoid;
    margin-bottom: var(--gap);
    overflow: hidden;
    border-radius: var(--radius);
    background: #1a1820;
  }

  .photo-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 0.3s ease, transform 0.4s ease;
    opacity: 0.92;
  }

  .photo-item:hover img {
    opacity: 1;
    transform: scale(1.012);
  }

  footer {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 96px;
    padding: 1.5rem 2rem;
    font-size: 0.75rem;
    color: var(--fg-muted);
    font-weight: 400;
    letter-spacing: 0.02em;
    font-family: var(--font-mono);
    text-align: center;
  }

  footer .decode {
    white-space: pre;
    position: relative;
    z-index: 1;
    /* Optical centering: the line box reserves descender space this string
       never uses ("© 2026 Pierce Liefeld" — no descenders, and no digit has
       one, so this holds whatever the year rolls over to), so the ink sits
       1px above true center. Nudge it back down. */
    transform: translateY(1px);
  }

  /* .char spans are built at runtime, so they never get Astro's scope
     attribute — this rule has to opt out of scoping to match them. */
  footer .decode :global(.char.scrambling) {
    color: var(--accent);
  }

  /* ---- Easter egg: a water buffalo trots through the footer on hover ---- */
  footer .critter {
    position: absolute;
    left: 0;
    top: 50%;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    /* -13px centres the box; the extra -0.9px is measured off the rendered
       glyph, whose ink sits low inside its own em box. */
    margin-top: -13.9px;
    opacity: 0;
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }

  footer .critter-glyph {
    /* Emoji fonts carry their own metrics, so the glyph does not sit where
       the line box implies — hence the fixed box, flex centring, and the
       measured offset on .critter above. */
    font-size: 19px;
    line-height: 1;
  }

  footer.trotting .critter {
    opacity: 1;
    animation: trot-across 2.6s linear;
  }

  footer.trotting .critter-glyph {
    animation: critter-bob 0.34s ease-in-out infinite;
  }

  /* Right-to-left: 🐃 faces left in every major emoji font, so travelling
     the other way would have it walking backwards. */
  @keyframes trot-across {
    from { transform: translate3d(calc(100vw + 40px), 0, 0); }
    to   { transform: translate3d(-40px, 0, 0); }
  }

  /* No legs to swing, so the gait is a bob plus a slight shoulder roll. */
  @keyframes critter-bob {
    0%, 100% { transform: translateY(1px) rotate(-2.5deg); }
    50%      { transform: translateY(-1px) rotate(2.5deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    footer.trotting .critter,
    footer.trotting .critter-glyph {
      animation: none;
    }
  }

  /* Responsive */
  @media (max-width: 900px) {
    .grid { column-count: 2; }
    header { padding: 2rem 1.25rem 1.5rem; }
    .cognak-preview { width: 304px; height: 171px; }
    .cognak-preview iframe { width: 1216px; height: 684px; transform: scale(0.25); }
  }

  @media (max-width: 540px) {
    .grid { column-count: 1; padding: 0 0.5rem 0.5rem; }
    header { padding: 100px 1rem 1rem; }
    .cognak-preview { display: none; }
  }
</style>
