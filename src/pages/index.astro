---
import Base from '../layouts/Base.astro';

const photos = [
  { src: '/photos/Glimpse.jpg', alt: 'Glimpse' },
  { src: '/photos/Isolated.jpg', alt: 'Isolated' },
  { src: '/photos/Kill-With-A-Smile.jpg', alt: 'Kill With A Smile' },
  { src: '/photos/A-Story-My-Father-Told-Me.jpg', alt: 'A Story My Father Told Me' },
  { src: '/photos/Scale.jpg', alt: 'Scale' },
  { src: '/photos/Not-So-Blue.jpg', alt: 'Not So Blue' },
  { src: '/photos/Procession.jpg', alt: 'Procession' },
  { src: '/photos/Light-the-Way.jpg', alt: 'Light the Way' },
  { src: '/photos/Live-Die-Live-Again.jpg', alt: 'Live Die Live Again' },
  { src: '/photos/Tolt.jpg', alt: 'Tölt' },
  { src: '/photos/Pass-the-Salt.jpg', alt: 'Pass the Salt' },
  { src: '/photos/Happy-Neigh-Year.jpg', alt: 'Happy Neigh Year' },
  { src: '/photos/Two-Birds.jpg', alt: 'Two Birds' },
  { src: '/photos/My-Light.jpg', alt: 'My Light' },
  { src: '/photos/Steering-Contest.jpg', alt: 'Steering Contest' },
  { src: '/photos/No-Nagging.jpg', alt: 'No Nagging' },
  { src: '/photos/Swoop.jpg', alt: 'Swoop' },
  { src: '/photos/Twinning.jpg', alt: 'Twinning' },
];
---

<Base
  title="Pierce Liefeld — Photographer & Founder of COGNAK"
  description="Photography by Pierce Liefeld. Art director and founder of COGNAK."
>
  <!-- Person + Organization schema -->
  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://pierceliefeld.com/#pierce",
        "name": "Pierce Liefeld",
        "url": "https://pierceliefeld.com",
        "image": "https://pierceliefeld.com/photos/Glimpse.jpg",
        "jobTitle": "Art Director",
        "description": "Art director, photographer, and founder of COGNAK.",
        "sameAs": ["https://cognak.com"],
        "worksFor": {
          "@type": "Organization",
          "@id": "https://cognak.com/#organization"
        }
      },
      {
        "@type": "Organization",
        "@id": "https://cognak.com/#organization",
        "name": "COGNAK",
        "url": "https://cognak.com",
        "founder": { "@id": "https://pierceliefeld.com/#pierce" }
      }
    ]
  })}</script>

  <main>
    <header>
      <div class="bio reveal">
        <h1>Pierce Liefeld</h1>
        <p>
          Art director. Photographer. Founder of&nbsp;<span class="cognak-wrap">
            <a href="https://cognak.com" target="_blank" rel="noopener" id="cognak-link">COGNAK</a>
            <span class="cognak-preview" id="cognak-preview">
              <iframe src="https://cognak.com" scrolling="no" tabindex="-1" loading="lazy" title="COGNAK"></iframe>
            </span>
          </span>.
        </p>
      </div>
    </header>

    <section class="grid">
      {photos.map((photo, i) => (
        <div class="photo-item reveal" style={`transition-delay: ${Math.min(i * 40, 200)}ms`}>
          <img
            src={photo.src}
            alt={photo.alt}
            loading={i < 6 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))}
    </section>

    <footer>
      <span class="horse" aria-hidden="true">
        <svg viewBox="0 0 44 32" role="presentation" focusable="false">
          <g class="h-body">
            <path class="h-leg leg-ff" d="M23 16 V 26.4" />
            <path class="h-leg leg-hf" d="M13.2 16 V 26.4" />
            <path class="h-tail" d="M11.8 14.6 C 8.2 15.6, 6.2 18.6, 5.6 22.4" />
            <path class="h-fill" d="M10.2 13.8
              C 13 11.4, 18.6 10.9, 23 11.2
              C 24.6 9.9, 26.4 8.6, 28.1 7.2
              L 28.2 5 L 29.7 6.5
              C 30.1 6.8, 30.3 7.2, 30.5 7.6
              L 34.6 11.6
              C 35.3 12.4, 34.9 13.4, 33.9 13.1
              L 31.7 12.4
              C 30.9 12.1, 30.3 11.6, 30 10.9
              C 28.7 12.3, 27.3 13.5, 26 14.8
              C 25.4 16.2, 25 17.2, 24.4 17.9
              C 20.4 19.1, 14.3 19.1, 11.1 18
              C 9.5 17.4, 9.4 15.1, 10.2 13.8 Z" />
            <path class="h-leg leg-fn" d="M23 16 V 26.4" />
            <path class="h-leg leg-hn" d="M13.2 16 V 26.4" />
          </g>
        </svg>
      </span>
      <span class="decode" data-text="© 2026 Pierce Liefeld">© 2026 Pierce Liefeld</span>
    </footer>
  </main>

  <!-- Randomize photo order on every page load -->
  <script is:inline>
    (function () {
      var grid = document.querySelector('.grid');
      if (!grid) return;
      var items = Array.prototype.slice.call(grid.children);
      for (var i = items.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = items[i]; items[i] = items[j]; items[j] = t;
      }
      items.forEach(function (el, idx) {
        el.style.transitionDelay = Math.min(idx * 40, 200) + 'ms';
        grid.appendChild(el);
      });
    })();
  </script>

  <!-- Footer text decode effect -->
  <script is:inline>
    (function () {
      var el = document.querySelector('footer .decode');
      if (!el) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var target = el.getAttribute('data-text') || el.textContent;
      var glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#%&*<>/';

      // Build a span per character
      el.textContent = '';
      var spans = [];
      for (var i = 0; i < target.length; i++) {
        var s = document.createElement('span');
        s.className = 'char';
        el.appendChild(s);
        spans.push(s);
      }

      function rand() { return glyphs[Math.floor(Math.random() * glyphs.length)]; }

      function run() {
        var settle = [];   // frame index at which each char locks in
        var total = 38;    // total frames
        for (var i = 0; i < target.length; i++) {
          settle[i] = Math.floor((i / target.length) * (total - 10)) + Math.floor(Math.random() * 8);
        }

        var frame = 0;
        function tick() {
          for (var i = 0; i < spans.length; i++) {
            var ch = target[i];
            if (ch === ' ') { spans[i].textContent = ' '; spans[i].className = 'char'; continue; }
            if (frame >= settle[i]) {
              spans[i].textContent = ch;
              spans[i].className = 'char';
            } else {
              spans[i].textContent = rand();
              spans[i].className = 'char scrambling';
            }
          }
          frame++;
          if (frame <= total) {
            requestAnimationFrame(tick);
          } else {
            for (var j = 0; j < spans.length; j++) {
              spans[j].textContent = target[j];
              spans[j].className = 'char';
            }
          }
        }
        tick();
      }

      // Kick off when the footer scrolls into view
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { run(); io.unobserve(entry.target); }
          });
        }, { threshold: 0.6 });
        io.observe(el);
      } else {
        run();
      }
    })();
  </script>

  <!-- Easter egg: hover the copyright and a horse trots through the footer -->
  <script is:inline>
    (function () {
      var footer = document.querySelector('footer');
      if (!footer) return;
      var trigger = footer.querySelector('.decode');
      var horse = footer.querySelector('.horse');
      if (!trigger || !horse) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var running = false;

      function gallop() {
        if (running) return;
        running = true;
        footer.classList.add('trotting');
      }

      // Only the travel animation is finite, and it lives on .horse itself —
      // the leg/bob loops are infinite and never fire animationend.
      horse.addEventListener('animationend', function (e) {
        if (e.target !== horse) return;
        footer.classList.remove('trotting');
        running = false;
      });

      trigger.addEventListener('mouseenter', gallop);
      trigger.addEventListener('click', gallop);
      trigger.addEventListener('touchstart', gallop, { passive: true });
    })();
  </script>
</Base>

<style>
  main {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  header {
    padding: 3rem 2rem 2rem;
    max-width: var(--max-w);
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  .bio h1 {
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--fg);
    margin-bottom: 0.35rem;
  }

  .bio p {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--fg-muted);
    line-height: 1.5;
  }

  /* COGNAK link + preview card */
  .cognak-wrap {
    position: relative;
    display: inline-block;
  }

  .bio a,
  .bio a:hover,
  .bio a:active,
  .bio a:focus {
    color: #9F50FF;
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .cognak-preview {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    width: 384px;
    height: 216px; /* 16:9 hero ratio */
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0,0,0,0.6), 0 0 0 1px rgba(159,80,255,0.25);
    opacity: 0;
    transform: translateY(-6px) scale(0.97);
    transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 100;
  }

  .cognak-wrap:hover .cognak-preview {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .cognak-preview iframe {
    width: 1536px;
    height: 864px; /* 16:9 of 1536 */
    transform: scale(0.25);
    transform-origin: top left;
    border: none;
    pointer-events: none;
  }

  /* Masonry */
  .grid {
    column-count: 3;
    column-gap: var(--gap);
    padding: 0 var(--gap) var(--gap);
    flex: 1;
  }

  .photo-item {
    break-inside: avoid;
    margin-bottom: var(--gap);
    overflow: hidden;
    border-radius: var(--radius);
    background: #1a1820;
  }

  .photo-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 0.3s ease, transform 0.4s ease;
    opacity: 0.92;
  }

  .photo-item:hover img {
    opacity: 1;
    transform: scale(1.012);
  }

  footer {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 96px;
    padding: 1.5rem 2rem;
    font-size: 0.75rem;
    color: var(--fg-muted);
    font-weight: 400;
    letter-spacing: 0.02em;
    font-family: var(--font-mono);
    text-align: center;
  }

  footer .decode {
    white-space: pre;
    position: relative;
    z-index: 1;
    /* Optical centering: the line box reserves descender space this string
       never uses ("© 2026 Pierce Liefeld" has no descenders), so the ink
       sits 1px above true center. Nudge it back down. */
    transform: translateY(1px);
  }

  /* .char spans are built at runtime, so they never get Astro's scope
     attribute — this rule has to opt out of scoping to match them. */
  footer .decode :global(.char.scrambling) {
    color: var(--accent);
  }

  /* ---- Easter egg: a horse trots through the footer on hover ---- */
  footer .horse {
    position: absolute;
    left: 0;
    top: 50%;
    width: 44px;
    height: 32px;
    margin-top: -16px;
    z-index: 0;
    opacity: 0;
    pointer-events: none;
    will-change: transform;
  }

  footer .horse svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  footer .h-fill {
    fill: var(--accent);
  }

  footer .h-tail,
  footer .h-leg {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
  }

  footer .h-tail {
    stroke-width: 1.5;
  }

  footer .h-leg {
    stroke-width: 2.1;
    transform-origin: 23px 16px;
  }

  footer .leg-hn,
  footer .leg-hf {
    transform-origin: 13.2px 16px;
  }

  footer.trotting .horse {
    opacity: 0.7;
    animation: trot-across 2.6s linear;
  }

  footer.trotting .h-body {
    animation: horse-bob 0.17s ease-in-out infinite;
  }

  footer.trotting .h-leg {
    animation: leg-swing 0.34s linear infinite;
  }

  /* Diagonal pairs move together — that's what makes it read as a trot. */
  footer.trotting .leg-ff,
  footer.trotting .leg-hn {
    animation-delay: -0.17s;
  }

  @keyframes trot-across {
    from { transform: translate3d(-64px, 0, 0); }
    to   { transform: translate3d(calc(100vw + 64px), 0, 0); }
  }

  @keyframes horse-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-1px); }
  }

  @keyframes leg-swing {
    0%   { transform: rotate(17deg); }
    50%  { transform: rotate(-17deg); }
    100% { transform: rotate(17deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    footer.trotting .horse,
    footer.trotting .h-body,
    footer.trotting .h-leg {
      animation: none;
    }
  }

  /* Responsive */
  @media (max-width: 900px) {
    .grid { column-count: 2; }
    header { padding: 2rem 1.25rem 1.5rem; }
    .cognak-preview { width: 304px; height: 171px; }
    .cognak-preview iframe { width: 1216px; height: 684px; transform: scale(0.25); }
  }

  @media (max-width: 540px) {
    .grid { column-count: 1; padding: 0 0.5rem 0.5rem; }
    header { padding: 100px 1rem 1rem; }
    .cognak-preview { display: none; }
  }
</style>
